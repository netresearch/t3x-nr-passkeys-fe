<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>General</sheetTitle>
                <type>array</type>
                <el>
                    <settings.discoverableEnabled>
                        <label>Discoverable login (no username required)</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <label>Use the site setting (TypoScript constant)</label>
                                    <value></value>
                                </numIndex>
                                <numIndex index="1" type="array">
                                    <label>On</label>
                                    <value>1</value>
                                </numIndex>
                                <numIndex index="2" type="array">
                                    <label>Off</label>
                                    <value>0</value>
                                </numIndex>
                            </items>
                            <default></default>
                        </config>
                    </settings.discoverableEnabled>
                    <settings.showPasswordFallback>
                        <label>Show password fallback link</label>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <label></label>
                                </numIndex>
                            </items>
                            <default>1</default>
                        </config>
                    </settings.showPasswordFallback>
                    <settings.passwordLoginPage>
                        <label>Password login page (target of the password fallback link)</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.passwordLoginPage>
                    <settings.redirectAfterLogin>
                        <label>Redirect after login</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.redirectAfterLogin>
                    <settings.cssClass>
                        <label>CSS class override</label>
                        <config>
                            <type>input</type>
                            <size>30</size>
                            <eval>trim</eval>
                        </config>
                    </settings.cssClass>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
