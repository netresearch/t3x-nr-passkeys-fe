plugin.tx_nrpasskeysfe {
    view {
        templateRootPaths.0 = EXT:nr_passkeys_fe/Resources/Private/Templates/
        partialRootPaths.0 = EXT:nr_passkeys_fe/Resources/Private/Partials/
        layoutRootPaths.0 = EXT:nr_passkeys_fe/Resources/Private/Layouts/
    }
    settings {
        discoverableEnabled = {$plugin.tx_nrpasskeysfe.settings.discoverableEnabled}
        css.includeDefault = {$plugin.tx_nrpasskeysfe.settings.css.includeDefault}
    }
}

# Override felogin template to add passkey button next to the Login button.
# This adds the passkey button inline within the felogin form.
# Integrators can disable this by removing the templateRootPaths override.
plugin.tx_felogin_login.view.templateRootPaths.100 = EXT:nr_passkeys_fe/Resources/Private/Templates/Felogin/
# The override renders the partial it shares with the login plugin
# (Partials/NrPasskeysFe/LoginAssets.html). The high key keeps it clear of the
# keys integrators usually give their own felogin partials.
plugin.tx_felogin_login.view.partialRootPaths.1700000000 = EXT:nr_passkeys_fe/Resources/Private/Partials/

# The overridden felogin templates read the same constants through felogin's
# own settings, the only settings a felogin template receives.
plugin.tx_felogin_login.settings.passkeys {
    discoverableEnabled = {$plugin.tx_nrpasskeysfe.settings.discoverableEnabled}
    css.includeDefault = {$plugin.tx_nrpasskeysfe.settings.css.includeDefault}
}
