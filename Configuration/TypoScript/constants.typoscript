plugin.tx_nrpasskeysfe {
    settings {
        # cat=plugin.tx_nrpasskeysfe//a; type=boolean; label=Discoverable login: Log in without a username, the passkey identifies the user. Default for the login plugin (its FlexForm overrides it per content element) and the setting the felogin integration follows. Off shows a username field.
        discoverableEnabled = 1
        # cat=plugin.tx_nrpasskeysfe//b; type=boolean; label=Include the default CSS: Load passkey-fe.css with the plugins and the felogin integration.
        css.includeDefault = 1
    }
}
